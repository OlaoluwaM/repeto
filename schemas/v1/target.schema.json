{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repeto:schema:v1:target",
  "title": "RepetoTargetDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "topic",
    "scope",
    "retrieval_demand",
    "canonical_question",
    "clean_answer_requirements",
    "verified_sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "retrieval_demand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["recall", "explain", "derive", "compare", "apply"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "canonical_question": { "type": "string", "minLength": 1 },
    "clean_answer_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "replaces_target_id": { "type": "string", "minLength": 1 }
  }
}
