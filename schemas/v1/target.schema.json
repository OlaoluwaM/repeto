{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repeto:schema:v1:target",
  "title": "RepetoTargetDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "source_notes"],
  "properties": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "can"],
      "properties": {
        "objective": { "$ref": "#/$defs/NonBlankString" },
        "can": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/NonBlankString" }
        }
      }
    },
    "source_notes": { "$ref": "#/$defs/NonBlankStringSet" }
  },
  "$defs": {
    "NonBlankString": {
      "title": "NonBlankString",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "NonBlankStringSet": {
      "title": "NonBlankStringSet",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/NonBlankString" }
    }
  }
}
