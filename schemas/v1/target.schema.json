{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repeto:schema:v1:target",
  "title": "RepetoTargetDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "topic",
    "scope",
    "retrieval_demand",
    "canonical_question",
    "correct_answer_requirements",
    "source_notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/NonBlankString" },
    "topic": { "$ref": "#/$defs/NonBlankString" },
    "scope": { "$ref": "#/$defs/NonBlankString" },
    "retrieval_demand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["recall", "explain", "derive", "compare", "apply"]
        },
        "description": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "canonical_question": { "$ref": "#/$defs/NonBlankString" },
    "correct_answer_requirements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/NonBlankString" }
    },
    "source_notes": { "$ref": "#/$defs/NonBlankStringSet" },
    "origin_references": { "$ref": "#/$defs/NonBlankStringSet" },
    "replaces_target_id": { "$ref": "#/$defs/NonBlankString" }
  },
  "$defs": {
    "NonBlankString": {
      "title": "NonBlankString",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "NonBlankStringSet": {
      "title": "NonBlankStringSet",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/NonBlankString" }
    }
  }
}
