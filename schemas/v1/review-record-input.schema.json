{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repeto:schema:v1:review-record-input",
  "title": "RepetoReviewRecordInput",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target_id", "session_id", "occurred_at", "assessment", "confidence", "metadata"],
      "properties": {
        "schema_version": { "const": 1 },
        "target_id": { "$ref": "#/$defs/NonBlankString" },
        "session_id": { "$ref": "#/$defs/NonBlankString" },
        "occurred_at": { "$ref": "#/$defs/ReviewInputUtcMillisecondTimestamp" },
        "assessment": { "$ref": "#/$defs/ReviewInputIndependentAssessment" },
        "confidence": { "type": "string", "enum": ["sure", "shaky", "guessing"] },
        "metadata": { "$ref": "#/$defs/ReviewInputMetadataWithAnswer" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target_id", "session_id", "occurred_at", "assessment", "metadata"],
      "properties": {
        "schema_version": { "const": 1 },
        "target_id": { "$ref": "#/$defs/NonBlankString" },
        "session_id": { "$ref": "#/$defs/NonBlankString" },
        "occurred_at": { "$ref": "#/$defs/ReviewInputUtcMillisecondTimestamp" },
        "assessment": { "$ref": "#/$defs/ReviewInputAssistedAssessment" },
        "metadata": { "$ref": "#/$defs/ReviewInputMetadataWithAnswer" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target_id", "session_id", "occurred_at", "assessment", "metadata"],
      "properties": {
        "schema_version": { "const": 1 },
        "target_id": { "$ref": "#/$defs/NonBlankString" },
        "session_id": { "$ref": "#/$defs/NonBlankString" },
        "occurred_at": { "$ref": "#/$defs/ReviewInputUtcMillisecondTimestamp" },
        "assessment": { "$ref": "#/$defs/ReviewInputNoAnswerAssessment" },
        "metadata": { "$ref": "#/$defs/ReviewInputMetadataWithoutAnswer" }
      }
    }
  ],
  "$defs": {
    "NonBlankString": {
      "title": "NonBlankString",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "NonBlankStringSet": {
      "title": "NonBlankStringSet",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/NonBlankString" }
    },
    "ReviewInputUtcMillisecondTimestamp": {
      "title": "ReviewInputUtcMillisecondTimestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ReviewInputAssessment": {
      "title": "ReviewInputAssessment",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_submitted",
        "target_knowledge_supplied_before_answer",
        "criteria_checks"
      ],
      "properties": {
        "answer_submitted": { "type": "boolean" },
        "target_knowledge_supplied_before_answer": { "type": "boolean" },
        "criteria_checks": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "ReviewInputIndependentAssessment": {
      "allOf": [
        { "$ref": "#/$defs/ReviewInputAssessment" },
        {
          "properties": {
            "answer_submitted": { "const": true },
            "target_knowledge_supplied_before_answer": { "const": false }
          }
        }
      ]
    },
    "ReviewInputAssistedAssessment": {
      "allOf": [
        { "$ref": "#/$defs/ReviewInputAssessment" },
        {
          "properties": {
            "answer_submitted": { "const": true },
            "target_knowledge_supplied_before_answer": { "const": true }
          }
        }
      ]
    },
    "ReviewInputNoAnswerAssessment": {
      "allOf": [
        { "$ref": "#/$defs/ReviewInputAssessment" },
        { "properties": { "answer_submitted": { "const": false } } }
      ]
    },
    "ReviewInputMetadata": {
      "title": "ReviewInputMetadata",
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "grading_explanation", "verification_sources", "difficulty", "source_note_issues"],
      "properties": {
        "prompt": { "$ref": "#/$defs/NonBlankString" },
        "answer": { "$ref": "#/$defs/NonBlankString" },
        "grading_explanation": { "$ref": "#/$defs/NonBlankString" },
        "verification_sources": { "$ref": "#/$defs/NonBlankStringSet" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "source_note_issues": { "type": "array", "items": { "$ref": "#/$defs/NonBlankString" } }
      }
    },
    "ReviewInputMetadataWithAnswer": {
      "allOf": [
        { "$ref": "#/$defs/ReviewInputMetadata" },
        { "required": ["answer"] }
      ]
    },
    "ReviewInputMetadataWithoutAnswer": {
      "allOf": [
        { "$ref": "#/$defs/ReviewInputMetadata" },
        { "not": { "required": ["answer"] } }
      ]
    }
  }
}
