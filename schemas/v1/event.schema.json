{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repeto:schema:v1:event",
  "title": "RepetoEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event_type", "occurred_at", "target_id", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "activation",
        "pause",
        "resume",
        "retirement",
        "revision",
        "review_completed",
        "needs_study_flag"
      ]
    },
    "occurred_at": { "$ref": "#/$defs/EventUtcMillisecondTimestamp" },
    "target_id": { "$ref": "#/$defs/NonBlankString" },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition"],
          "properties": { "definition": { "$ref": "urn:repeto:schema:v1:target" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "$ref": "#/$defs/NonBlankString" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["new_target_id", "reason", "carry_history", "definition"],
          "properties": {
            "new_target_id": { "$ref": "#/$defs/NonBlankString" },
            "reason": { "$ref": "#/$defs/NonBlankString" },
            "carry_history": { "type": "boolean" },
            "definition": { "$ref": "urn:repeto:schema:v1:target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "assessment",
            "metadata",
            "assessment_policy_id",
            "result",
            "scheduling"
          ],
          "properties": {
            "session_id": { "$ref": "#/$defs/NonBlankString" },
            "assessment": { "$ref": "#/$defs/EventAssessment" },
            "confidence": { "type": "string", "enum": ["sure", "shaky", "guessing"] },
            "metadata": { "$ref": "#/$defs/EventReviewMetadata" },
            "assessment_policy_id": { "const": "repeto-analytic-conjunctive-v1" },
            "result": { "type": "string", "enum": ["correct", "not_correct"] },
            "scheduling": { "$ref": "#/$defs/Scheduling" }
          },
          "oneOf": [
            {
              "required": ["confidence"],
              "properties": {
                "assessment": { "$ref": "#/$defs/EventIndependentAssessment" },
                "metadata": { "$ref": "#/$defs/EventReviewMetadataWithAnswer" }
              }
            },
            {
              "not": { "required": ["confidence"] },
              "properties": {
                "assessment": { "$ref": "#/$defs/EventAssistedAssessment" },
                "metadata": { "$ref": "#/$defs/EventReviewMetadataWithAnswer" }
              }
            },
            {
              "not": { "required": ["confidence"] },
              "properties": {
                "assessment": { "$ref": "#/$defs/EventNoAnswerAssessment" },
                "metadata": { "$ref": "#/$defs/EventReviewMetadataWithoutAnswer" }
              }
            }
          ]
        }
      ]
    }
  },
  "$defs": {
    "NonBlankString": {
      "title": "NonBlankString",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "NonBlankStringSet": {
      "title": "NonBlankStringSet",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/NonBlankString" }
    },
    "EventUtcMillisecondTimestamp": {
      "title": "EventUtcMillisecondTimestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "MemoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stability", "difficulty"],
      "properties": {
        "stability": { "type": "number", "minimum": 0 },
        "difficulty": { "type": "number", "minimum": 0 }
      }
    },
    "EventAssessment": {
      "title": "EventAssessment",
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_submitted", "target_knowledge_supplied_before_answer", "requirement_checks"],
      "properties": {
        "answer_submitted": { "type": "boolean" },
        "target_knowledge_supplied_before_answer": { "type": "boolean" },
        "requirement_checks": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "EventIndependentAssessment": {
      "allOf": [
        { "$ref": "#/$defs/EventAssessment" },
        {
          "properties": {
            "answer_submitted": { "const": true },
            "target_knowledge_supplied_before_answer": { "const": false }
          }
        }
      ]
    },
    "EventAssistedAssessment": {
      "allOf": [
        { "$ref": "#/$defs/EventAssessment" },
        {
          "properties": {
            "answer_submitted": { "const": true },
            "target_knowledge_supplied_before_answer": { "const": true }
          }
        }
      ]
    },
    "EventNoAnswerAssessment": {
      "allOf": [
        { "$ref": "#/$defs/EventAssessment" },
        { "properties": { "answer_submitted": { "const": false } } }
      ]
    },
    "EventReviewMetadata": {
      "title": "EventReviewMetadata",
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "grading_explanation", "verification_sources"],
      "properties": {
        "prompt": { "$ref": "#/$defs/NonBlankString" },
        "answer": { "$ref": "#/$defs/NonBlankString" },
        "grading_explanation": { "$ref": "#/$defs/NonBlankString" },
        "verification_sources": { "$ref": "#/$defs/NonBlankStringSet" }
      }
    },
    "EventReviewMetadataWithAnswer": {
      "allOf": [
        { "$ref": "#/$defs/EventReviewMetadata" },
        { "required": ["answer"] }
      ]
    },
    "EventReviewMetadataWithoutAnswer": {
      "allOf": [
        { "$ref": "#/$defs/EventReviewMetadata" },
        { "not": { "required": ["answer"] } }
      ]
    },
    "Scheduling": {
      "title": "Scheduling",
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "input", "output"],
      "properties": {
        "scheduler": { "$ref": "#/$defs/SchedulerIdentity" },
        "input": { "$ref": "#/$defs/SchedulingInput" },
        "output": { "$ref": "#/$defs/SchedulingOutput" }
      }
    },
    "SchedulerIdentity": {
      "title": "SchedulerIdentity",
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "fuzz_enabled", "parameters"],
      "properties": {
        "implementation": { "const": "fsrs-rs" },
        "version": { "const": "6.6.2" },
        "fuzz_enabled": { "const": false },
        "parameters": { "type": "array", "minItems": 21, "maxItems": 21, "items": { "type": "number" } }
      }
    },
    "SchedulingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_memory_state", "elapsed_days", "rating", "desired_retention"],
      "properties": {
        "prior_memory_state": { "anyOf": [{ "$ref": "#/$defs/MemoryState" }, { "type": "null" }] },
        "elapsed_days": { "type": "integer", "minimum": 0 },
        "rating": { "type": "string", "enum": ["Again", "Good"] },
        "desired_retention": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "SchedulingOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_state", "interval_days", "retrievability_at_due", "due_at"],
      "properties": {
        "memory_state": { "$ref": "#/$defs/MemoryState" },
        "interval_days": { "type": "integer", "minimum": 0 },
        "retrievability_at_due": {
          "description": "Retrievability computed from the resulting memory state at the stored `due_at` time.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "due_at": { "$ref": "#/$defs/EventUtcMillisecondTimestamp" }
      }
    }
  }
}
