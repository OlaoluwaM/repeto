{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repeto:schema:v1:config",
  "title": "RepetoConfiguration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_note_root",
    "desired_retention",
    "scheduler",
    "fuzz_enabled",
    "default_recommended_target_count",
    "queue_priority_policy_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_note_root": { "$ref": "#/$defs/NonBlankString" },
    "desired_retention": { "type": "number", "const": 0.9 },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "parameters"],
      "properties": {
        "implementation": { "const": "fsrs-rs" },
        "version": { "const": "6.6.2" },
        "parameters": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": { "type": "number" }
        }
      }
    },
    "fuzz_enabled": { "const": false },
    "default_recommended_target_count": { "type": "integer", "minimum": 1 },
    "queue_priority_policy_version": { "type": "integer", "minimum": 1, "maximum": 4 },
    "rotation_groups": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "maxLength": 80,
        "not": { "enum": ["ambiguous", "no-suitable-group", "constructor", "prototype"] }
      },
      "additionalProperties": { "$ref": "#/$defs/RotationGroup" }
    }
  },
  "$defs": {
    "RotationGroup": {
      "title": "RotationGroup",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "topics"],
      "properties": {
        "label": { "$ref": "#/$defs/NonBlankString" },
        "description": { "$ref": "#/$defs/NonBlankString" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/NonBlankString" }
        }
      }
    },
    "NonBlankString": {
      "title": "NonBlankString",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
